<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Create Session - Sports Scheduler</title>
</head>

<body>

  <h1>Create Sport Session</h1>

  <form action="/sessions/create" method="POST">

    <label for="sportId">Sport:</label>
    <select id="sportId" name="sportId" required>
      <% sports.forEach((sport) => { %>
        <option value="<%= sport.id %>">
          <%= sport.name %>
        </option>
      <% }) %>
    </select>

    <br><br>

    <label for="date">Date:</label>
    <input type="date" id="date" name="date" required>

    <br><br>

    <label for="startTime">Start Time:</label>
    <input type="time" id="startTime" name="startTime" required>

    <br><br>

    <label for="endTime">End Time:</label>
    <input type="time" id="endTime" name="endTime" required>

    <br><br>

    <label for="maxPlayers">Maximum Players:</label>
    <input type="number" id="maxPlayers" name="maxPlayers" min="1" required>

    <br><br>

    <button type="submit">Create Session</button>

  </form>

  <br>

  <a href="/dashboard">Back to Dashboard</a>

</body>
</html>