<!DOCTYPE html>
<html>
<head>
    <title>Edit Session</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <h1>Edit Session</h1>

    <form action="/sessions/<%= session.id %>/edit" method="POST">

        <label>Sport:</label>
        <br>

        <select name="sportId" required>

            <% sports.forEach(sport => { %>

                <option
                    value="<%= sport.id %>"
                    <%= sport.id === session.sportId ? "selected" : "" %>
                >
                    <%= sport.name %>
                </option>

            <% }) %>

        </select>

        <br><br>

        <label>Date:</label>
        <br>

        <input
            type="date"
            name="date"
            value="<%= session.date %>"
            required
        >

        <br><br>

        <label>Start Time:</label>
        <br>

        <input
            type="time"
            name="startTime"
            value="<%= session.startTime %>"
            required
        >

        <br><br>

        <label>End Time:</label>
        <br>

        <input
            type="time"
            name="endTime"
            value="<%= session.endTime %>"
            required
        >

        <br><br>

        <label>Maximum Players:</label>
        <br>

        <input
            type="number"
            name="maxPlayers"
            value="<%= session.maxPlayers %>"
            min="1"
            required
        >

        <br><br>

        <button type="submit">Update Session</button>

    </form>

    <p>
        <a href="/sessions">Back to Sessions</a>
    </p>

</body>
</html>