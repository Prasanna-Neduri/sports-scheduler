<!DOCTYPE html>
<html>
<head>
    <title>Edit Sport</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <h1>Edit Sport</h1>

    <form action="/sports/<%= sport.id %>/edit" method="POST">

        <label>Sport Name:</label>
        <br>

        <input
            type="text"
            name="name"
            value="<%= sport.name %>"
            required
        >

        <br><br>

        <label>Description:</label>
        <br>

        <textarea
            name="description"
            rows="5"
            cols="40"
        ><%= sport.description || "" %></textarea>

        <br><br>

        <button type="submit">Update Sport</button>

    </form>

    <p>
        <a href="/sports">Back to Sports</a>
    </p>

</body>
</html>